ARG BASE_IMAGE=ubuntu:26.04
FROM $BASE_IMAGE as build
ARG TARGETARCH

# Kernel modules are not installed in the image; the containers mount
# /lib/modules from the machine that runs them.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        systemd systemd-sysv conntrack iptables iproute2 ethtool socat util-linux mount \
        apparmor-utils ebtables kmod libseccomp2 pigz bash ca-certificates \
        rsync nfs-common fuse-overlayfs curl gnupg2 \
        dbus ufw

# The containers are privileged and share the swap of the machine that runs
# them, so `swapoff -a` of the installer would turn off the swap of the
# machine. These do nothing instead, as /usr/local/sbin comes before /usr/sbin
# in PATH; the kubelet is told not to fail on swap.
RUN for cmd in swapoff swapon; do \
        printf '#!/bin/sh\n# Does nothing in the BYOH host containers of the tests.\nexit 0\n' > "/usr/local/sbin/${cmd}"; \
        chmod 755 "/usr/local/sbin/${cmd}"; \
    done

FROM scratch
COPY --from=build / /

ENTRYPOINT ["/sbin/init"]
